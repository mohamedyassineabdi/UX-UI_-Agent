# Copy this file to /etc/ux-ui-auditor.env on the server.
# Do not commit real secrets.

PYTHONUNBUFFERED=1
HOST=127.0.0.1
PORT=8787

# Server/container-safe browser defaults. Set AUDIT_BROWSER_HEADLESS=0 only on a
# desktop machine with a visible browser session available.
AUDIT_BROWSER_HEADLESS=1
AUDIT_BROWSER_TYPE=chromium
AUDIT_BROWSER_CHANNEL=
AUDIT_BROWSER_SLOW_MO_MS=0
AUDIT_PAGE_CONCURRENCY=2

# Optional: AI review backend. Supported values in code: ollama, groq, openai.
AI_REVIEW_BACKEND=ollama
AI_REVIEW_BASE_URL=http://127.0.0.1:11434
AI_REVIEW_MODEL=llama3.2
AI_REVIEW_API_KEY=
AI_REVIEW_TIMEOUT=120

# Optional: Ollama / crawler / GTM vision settings.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_API_KEY=
GTM_VISION_BASE_URL=http://127.0.0.1:11434
GTM_VISION_MODEL=llama3.2-vision
GTM_VISION_API_KEY=

# Keep AI navigation off unless the configured model is available and tested.
CRAWLER_USE_AI_NAV=0
USE_AI_NAV=0

# Vercel CLI for automatic deployed audit reports.
# In Docker/CI, set all three values below from a linked Vercel project.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_SCOPE=

# Mobile audits require Appium/ADB to be installed separately.
ANDROID_HOME=
ANDROID_SDK_ROOT=
